{
  "manifest_version": "0.3",
  "name": "yaptake",
  "display_name": "Yaptake",
  "version": "0.1.3",
  "description": "Edit video for every feed (9:16, 4:5, 1:1 or 16:9) in a native Mac app with a transcript, captions and timeline. Local tools let coding agents work on the same project.",
  "author": {
    "name": "Hraness",
    "url": "https://hraness.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/product-skills"
  },
  "homepage": "https://yaptake.com",
  "documentation": "https://yaptake.com/docs/agents",
  "support": "https://yaptake.com/support",
  "icon": "assets/icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.mjs"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  },
  "privacy_policies": [
    "https://yaptake.com/privacy"
  ],
  "keywords": [
    "video",
    "editing",
    "captions",
    "transcript",
    "mac"
  ],
  "license": "MIT"
}
