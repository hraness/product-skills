  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Sponge",
        "shortDescription": "Reading and notes.",
        "developerName": "Hraness",
        "category": "Productivity",
        "websiteURL": "https://sponge.computer"
      }
    }
  }
}
